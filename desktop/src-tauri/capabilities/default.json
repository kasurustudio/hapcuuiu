{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin default window utama — termasuk menjalankan sidecar backend Python.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/stockapp-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
