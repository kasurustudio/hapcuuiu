{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Analysis Platform",
  "version": "0.1.0",
  "identifier": "com.stockanalysisplatform.app",
  "build": {
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "Stock Analysis Platform",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/stockapp-backend"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
