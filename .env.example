# --- Database ---
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stockapp
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://stockapp:changeme@db:5432/stockapp

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Market data ---
# Provider aktif untuk market IDX. Untuk MVP hanya "yfinance" (gratis, degraded
# mode: swing & investing saja, scalping/day trading dinonaktifkan).
MARKET_DATA_PROVIDER_IDX=yfinance

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
